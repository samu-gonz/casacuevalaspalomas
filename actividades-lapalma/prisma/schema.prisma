// ActividadesLaPalma — Prisma schema (Phase 1)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Place {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  summary         String
  hasPremium      Boolean
  zone            String
  difficulty      String
  durationMinutes Int
  distanceKm      Float
  coverImageUrl   String
  gpsLat          Float
  gpsLng          Float
  content         String   @db.Text
  premiumContent  String?  @db.Text
  pdfUrl          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Purchase {
  id              String   @id @default(cuid())
  email           String
  stripeSessionId String   @unique
  amountPaid      Int
  discountApplied Boolean
  discountCode    String?
  createdAt       DateTime @default(now())
}

model AccessToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?
}

model DiscountCode {
  id         String   @id @default(cuid())
  code       String   @unique
  percentOff Int
  active     Boolean
  usedCount  Int      @default(0)
  createdAt  DateTime @default(now())
}
